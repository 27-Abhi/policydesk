# LangSmith Observability Tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_pt_your_api_key_here
LANGSMITH_PROJECT=policydesk
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Database & Persistence Configuration
# Leave DATABASE_URL blank to use the in-memory bank store for local tests
DATABASE_URL=postgresql://policydesk:policydesk_secure_pass@localhost:5432/policydesk
CHECKPOINT_DB_PATH=data/checkpoints.db
VECTOR_DB_PATH=data/vectors.db

# Ingress & Security Configuration
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:8001
# Optional API key to protect Port 8001 admin endpoints (X-Admin-Key or Bearer token)
# ADMIN_API_KEY=change-me-in-production

# RAG & Agentic Controls
# Set ENABLE_REMOTE_EMBEDDINGS=true to use OpenAI/Ollama embeddings instead of local semantic vectors
ENABLE_REMOTE_EMBEDDINGS=false
# Set USE_LLM_ROUTER=true to enable LLM-assisted structured intent classification
USE_LLM_ROUTER=false
# Set ENABLE_LLM_RERANK=true to enable LLM relevance verification during grading/grounding
ENABLE_LLM_RERANK=false


# LLM Provider Configuration
# Priority: Anthropic > OpenAI > Ollama > DeterministicMockFallback

# 1. Local Ollama (Zero API cost, works completely offline)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:1b
# Other lightweight local models: qwen3:0.6b, qwen3.5:0.8b, phi3:mini

# 2. OpenAI (Cloud)
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-4o-mini

# 3. Anthropic Claude (Cloud)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
